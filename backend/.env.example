# =============================================================================
# Copy this file to `.env` in the SAME folder (`backend/`) and fill in values.
# Start the API from `backend/` so `python-dotenv` picks up `.env`:
#   uvicorn main:app --reload --host 0.0.0.0 --port 8000
#
# Database schema (includes chat tables): from `backend/` run:
#   alembic upgrade head
#
# Vector index for RAG (first time / after changing corpus path):
#   python -m chatbot.build_index
# =============================================================================

# --- Runtime and PostgreSQL ---
ENVIRONMENT=development
# Production deployments should set DATABASE_URL directly (postgresql:// or postgres://).
DATABASE_URL=
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your-postgres-password
PG_DATABASE=rag_chatbot

# --- JWT & API key auth ---
# SECRET_KEY: must match signing; change in production (long random string).
SECRET_KEY=change-to-long-random-string
JWT_ALGORITHM=HS256
TOKEN_EXPIRY_HOURS=24

# X_API_KEY: required for signup/login endpoints; frontend sends this as NEXT_PUBLIC_X_API_KEY
X_API_KEY=your-backend-x-api-key

# --- URLs, CORS, and uploads ---
BASE_URL=http://127.0.0.1:8000
# Comma-separated frontend origins; required in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_NAME=RAG Chatbot
# MEDIA_PATH: where profile uploads go (relative to cwd or absolute)
MEDIA_PATH=media

# =============================================================================
# RAG / chatbot (read by `chatbot/settings.py`; no NEXT_PUBLIC_* here)
# =============================================================================

# Vertical: rera | company | medical (see chatbot/prompts.py — add more as needed)
CHATBOT_DOMAIN_PROFILE=rera

# Sentence Transformers model for embeddings (downloads on first use)
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional: path to .xlsx / .csv / .tsv (omit → first spreadsheet in chatbot/data/, else sample TSV)
# CHATBOT_SOURCE_CSV=/full/path/to/rera_projects.xlsx

# Optional: absolute path where embeddings + chunk JSON are stored (omit → chatbot/storage/)
# CHATBOT_STORAGE_DIR=

# How many chunks to retrieve before calling the LLM
RAG_TOP_K=5

# --- LLM: pick ONE provider ---
# LLM_PROVIDER: mock | openai | gemini | ollama
# mock = no external API (echoes retrieved context; good for testing RAG wiring)
LLM_PROVIDER=ollama

# Ollama (local — run `ollama serve` and `ollama pull llama3.2`)
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=120

# Gemini (Google AI Studio / Generative AI API)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash-lite

# OpenAI (only if LLM_PROVIDER=openai)
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4o-mini

# --- Multi-agent RAG tuning (LangGraph pipeline) ---
# Hybrid retrieval: semantic (vector) + BM25 keyword search
RAG_VECTOR_WEIGHT=0.7
RAG_BM25_WEIGHT=0.3
RAG_CANDIDATE_MULTIPLIER=12
# RAG_MIN_RELEVANCE_SCORE=0.35
# RAG_CONTEXT_CHUNK_CHARS=1800

# =============================================================================
# Frontend (NEXT.js `.env.local` in `frontend/` — separate from this file)
# Match the backend X_API_KEY and point at your API when not using Next rewrites:
#   NEXT_PUBLIC_X_API_KEY=your-backend-x-api-key
#   NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Optional Next rewrite target:
#   BACKEND_URL=http://127.0.0.1:8000
# =============================================================================
